   "tag": "section",
   "html": "<div class=\"section-head\">\n<div>\n<div class=\"eyebrow\">Nos propositions</div>\n<h2 data-tm-title=\"\" id=\"tm-res-titre\">Cochez une case pour commencer</h2>\n</div>\n<a class=\"btn btn-ghost\" href=\"/programmes\">Toutes les thématiques →</a>\n</div>\n<div aria-live=\"polite\">\n<p class=\"tm-summary\" data-tm-summary=\"\"></p>\n<div class=\"tm-results\" data-tm-results=\"\"></div>\n</div>"
